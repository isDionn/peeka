{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Peeka",
  "mainBinaryName": "peeka",
  "version": "0.1.0",
  "identifier": "dev.notch.app",
  "build": {
    "devUrl": "http://127.1.2.7:5174",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
